<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My Personal Space</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
          rel="stylesheet" 
          integrity="sha384-sRII4kxILFvY47J16cr9ZwbO07vP4J8+LH7qKQnuqkulAv-NWLzeN8tE5YBujZqJLB" 
          crossorigin="anonymous">

    <style>
        body {
            background: linear-gradient(135deg, #f7f6f6 0%, #000000 100%);
            min-height: 100vh;
        }
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgb(254, 254, 254);
        }
        .profile-img {
            width: 160px;
            height: 160px;
            object-fit: cover;
            border: 5px solid #ffffff;
            margin-top: -80px;
        }
        .nav-pills .nav-link.active {
            background-color: #ffffff;
        }
        .nav-pills .nav-link {
            color: #555;
        }
        .progress-bar {
            background-color: #ffffff;
        }
        .bg-primary-custom {
            background-color: #ffffff;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary-custom shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">🚀 My Personal Space</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link active" href="#about">About Me</a></li>
                    <li class="nav-item"><a class="nav-link" href="#interests">Interests</a></li>
                    <li class="nav-item"><a class="nav-link" href="#gallery">Gallery</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                </ul>
            </div>
        </div>
    </nav>

                        <div class="tab-content text-start px-2">
                            <div class="tab-pane fade show active" id="about">
                                <h5 class="fw-semibold mb-2">👋 Hello!</h5>
                                <p>I'm a second-year Bachelor of Science in Information Technology student. I love building things on the web and exploring new technologies. I believe in discipline, teamwork, and continuous learning — both in sports and in coding.</p>
                                <p class="mb-0">📍 Pangasinan, Philippines</p>
                            </div>

                            <div class="tab-pane fade" id="goals">
                                <h5 class="fw-semibold mb-3">🎯 My Goals</h5>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item"> Learn Web Development & UI Design</li>
                                    <li class="list-group-item"> Learn Backend & Database Management</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mb-5" id="interests">
            <div class="col-lg-8">
                <div class="card p-4">
                    <h3 class="fw-bold text-center mb-4">❤️ My Interests & Hobbies</h3>
                    <div class="row g-3 text-center">
                        <div class="col-6 col-md-4">
                            <div class="p-3 rounded bg-light border h-100">
                                <h4>🏀</h4>
                                <p class="mb-0">Basketball</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-3 rounded bg-light border h-100">
                                <h4>📚</h4>
                                <p class="mb-0">Learning New Tech</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-3 rounded bg-light border h-100">
                                <h4>🎵</h4>
                                <p class="mb-0">Music</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-3 rounded bg-light border h-100">
                                <h4>✈️</h4>
                                <p class="mb-0">Travel</p>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="p-3 rounded bg-light border h-100">
                                <h4>💻</h4>
                                <p class="mb-0">Coding</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center" id="contact">
            <div class="col-lg-8">
                <div class="card p-4">
                    <h3 class="fw-bold text-center mb-4">📬 Connect With Me</h3>
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Your Name</label>
                            <input type="text" class="form-control" placeholder="Enter your name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" class="form-control" placeholder="your@email.com" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Message</label>
                            <textarea class="form-control" rows="4" placeholder="Write your message here..." required></textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-primary-custom text-white px-5 py-2 rounded-pill">Send Message</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

    <footer class="text-center text-white py-4 mt-4">
        <p class="mb-0">© 2026 Brent Joshua L. Perez — BSIT 2B | All Rights Reserved</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" 
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPIVlz7YYwJrWVcXK/BmnVDxM+D2scQblTxl" 
            crossorigin="anonymous"></script>
</body>
</html>
